---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us | Bravo's Painting Company" description="Request a free estimate or book an appointment with Bravo's Painting Company. Serving Orange County, CA.">

  <!-- Hero -->
  <section class="bg-brand py-16 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold">Request an Appointment</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/80">
        Fill out the form below and we'll get back to you with a free estimate. We typically respond within a few hours.
      </p>
    </div>
  </section>

  <!-- Contact info strip -->
  <section class="border-b border-gray-100 bg-white py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-3">

        <!-- Phone -->
        <a href="tel:+16574334791" class="flex items-center gap-4 rounded-xl border border-gray-100 p-4 shadow-sm hover:border-brand/30 hover:shadow-md transition-all">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Call or Text</p>
            <p class="text-lg font-bold text-gray-900">(657) 433-4791</p>
          </div>
        </a>

        <!-- Email -->
        <a href="mailto:info@bravospaintingcompany.com" class="flex items-center gap-4 rounded-xl border border-gray-100 p-4 shadow-sm hover:border-brand/30 hover:shadow-md transition-all">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Email Us</p>
            <p class="text-sm font-bold text-gray-900">info@bravospaintingcompany.com</p>
          </div>
        </a>

        <!-- Location -->
        <div class="flex items-center gap-4 rounded-xl border border-gray-100 p-4 shadow-sm">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Service Area</p>
            <p class="text-lg font-bold text-gray-900">Orange County, CA</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- DripJobs booking form -->
  <section class="bg-gray-50 py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <iframe
          src="https://app.dripjobs.com/appointmentrequests?companyId=751910376162e20e09dea24c1f8762&formId=75888298148aa73c7783f34aa8898c"
          width="100%"
          height="900"
          frameborder="0"
          title="Book an Appointment"
          style="display:block;"
        ></iframe>
      </div>
      <p class="mt-4 text-center text-sm text-gray-400">
        Licensed, Insured & Bonded &middot; Lic #1149855 &middot; Orange County, CA
      </p>
    </div>
  </section>

</BaseLayout>
